{
  "listen": ":7863",
  "api_key": "",
  "auth_dir": "./auths",
  "state_file": "./data/state.json",
  "dns_servers": [],
  "server": {
    "read_timeout": "300s",
    "shutdown_timeout": "30s",
    "max_body_mb": 64
  },
  "panel": {
    "api_key": "",
    "poll_interval_sec": 5,
    "package_detail_limit": 5,
    "events_enabled": true
  },
  "security": {
    "allow_anonymous": false
  },
  "logging": {
    "request_archive_enabled": true,
    "request_retention_days": 7,
    "request_archive_max_mb": 100,
    "request_client_info": true
  },
  "jobs": {
    "max_concurrency": 4,
    "retain": 50
  },
  "notify": {
    "webhook_url": "",
    "timeout": "10s",
    "channel": "webhook",
    "telegram_chat_id": "",
    "title": "WorkBuddy2API Pro",
    "events": ["job_done", "account_disabled", "checkin_failed"]
  },
  "cooldown": {
    "soft_rate": "600s",
    "soft_rate_max": "2h"
  },
  "schedule": {
    "checkin_hours": [9, 21],
    "growth_hours": [1],
    "travel_hours": [9, 21],
    "activity_hours": [10],
    "keepalive_hours": [22],
    "blackcat_hours": [23],
    "checkin_enabled": true,
    "growth_enabled": true,
    "travel_enabled": true,
    "activity_enabled": true,
    "keepalive_enabled": true,
    "blackcat_enabled": true,
    "balance_refresh_enabled": true,
    "balance_refresh_minutes": 5,
    "balance_refresh_concurrency": 8,
    "balance_refresh_startup_delay": "30s",
    "balance_refresh_startup_force": false,
    "catch_up_minutes": 120,
    "include_disabled_in_tasks": false,
    "task_sweep_concurrency": 8,
    "checkin_concurrency": 3
  },
  "global": {
    "enabled": true,
    "chat_base": "",
    "billing_base": ""
  },
  "cn": {
    "chat_base": ""
  },
  "upstream": {
    "timeout_seconds": 120,
    "header_timeout_seconds": 120,
    "idle_timeout_seconds": 300,
    "user_agent": "",
    "client_version": "",
    "cli_version": "",
    "client_name": "",
    "device_token": "",
    "device_token_file": "",
    "passthrough_ip": false
  },
  "features": {
    "sanitize_blacklist_fingerprints": true
  },
  "models": {
    "_comment": "hidden: 不对外暴露的模型黑名单。裸名=两域都藏；\"cn:xxx\"/\"global:xxx\"=只藏该域。/v1/models 列表过滤 + chat 点名拒绝，面板保存后热生效。",
    "hidden": []
  },
  "prompt": {
    "mode": "passthrough",
    "file": ""
  },
  "upstash": {
    "url": "",
    "token": ""
  },
  "pool": {
    "strategy": {
      "domestic": "weighted_random",
      "international": "weighted_random"
    },
    "account_order": {
      "domestic": [],
      "international": []
    },
    "max_in_flight": 3,
    "max_in_flight_global": 2,
    "breaker_threshold": 3,
    "breaker_cooldown": "30m",
    "breaker_cooldown_max": "6h",
    "degrade_threshold": 5,
    "degrade_cooldown": "10m",
    "degrade_cooldown_max": "2h",
    "idle_weight_per_hour": 0.5,
    "idle_weight_max": 5.0,
    "prefer_expiring": true,
    "expiring_soon": "168h",
    "cost_explore_interval": "30m",
    "credit_floor": 100,
    "cross_domain_fallback": false
  },
  "session_sticky": {
    "enabled": true,
    "ttl": "30m",
    "gc_interval": "5m"
  }
}
